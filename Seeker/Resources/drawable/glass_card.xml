<?xml version="1.0" encoding="utf-8"?>
<!-- SeekerOG glass card: translucent surface + subtle highlight edge. Cheap to draw (no blur), safe for lists. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/glassSurface" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="?attr/glassStroke" />
        </shape>
    </item>
    <item android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp" />
        </shape>
    </item>
</layer-list>
