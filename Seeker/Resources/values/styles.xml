<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">?attr/mainPurpleStatusBar</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="android:windowActionModeOverlay">true</item>
        <item name="windowActionModeOverlay">true</item>
		<item name="actionModeStyle">@style/MyActionMode</item>
	</style>

	<style name="MyActionMode" parent="Widget.AppCompat.ActionMode">
		<item name="background">?attr/appBarColor</item>
		<item name="titleTextStyle">@style/MyActionModeTitle</item>
	</style>

	<style name="MyActionModeTitle" parent="TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">?attr/appBarTextColor</item>
	</style>

    <style name="OutlinedRoundedBox" parent="">
        <item name="shapeAppearanceOverlay">
            @style/ShapeAppearanceOverlay.MyApp.TextInputLayout.Rounded
        </item>
    </style>

    <style
        name="ShapeAppearanceOverlay.MyApp.TextInputLayout.Rounded"
        parent=""
    >
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <!-- SeekerOG glass defaults (classic themes keep their solid look) -->
        <item name="glassWindowBackground">?attr/pseudo_window_background_color</item>
        <item name="glassSurface">?attr/surface_variant1</item>
        <item name="glassSurfaceStrong">?attr/dialog_background</item>
        <item name="glassStroke">#22000000</item>
        <item name="glassCardBackground">@drawable/glass_card_classic</item>
        <item name="glassNavBackground">@drawable/glass_nav_classic</item>
        <item name="glassAccent">?attr/mainPurple</item>
        <item name="glassAccentSecondary">?attr/colorPrimary</item>
        <item name="glassOnAccent">#FFFFFF</item>
        <item name="glassTextPrimary">?attr/normalTextColor</item>
        <item name="glassTextSecondary">?attr/cellTextColorSubdued</item>
        <item name="glassCardColor">?attr/colorSurfaceLogin</item>
        <item name="glassOutline">#1F000000</item>
        <item name="glassFieldColor">?attr/dialog_background</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">#4f58c4</item>
        <item name="colorSecondaryContainer">#e4e6f6</item>
        <item name="mainPurple">#4f58c4</item>
        <item name="swipeToRefreshProgress">#4f58c4</item>
        <item name="swipeToRefreshBackground">#ffffffff</item>
        <item name="mainPurpleStatusBar">@color/colorPrimaryDark</item>

        <item name="whitePurpleForNavBar">#858ddd</item>

        <item name="mainPurpleForNavBar">?attr/mainPurple</item>
        <item name="appBarColor">?attr/mainPurple</item>
        <item name="roomStatusesColor">?attr/surface_variant1</item>
        <item name="appBarIconColor">@android:color/white</item>
        <item name="appBarTextColor">@android:color/white</item>
        <item name="appBarHintColor">@android:color/white</item>
        <item name="appBarOverlayTheme">@style/AppTheme.AppBarOverlay</item>
        <item name="searchBarColor">#33FFFFFF</item>
        <item name="searchBarHighlightColor">@android:color/white</item>
        <item name="checkCircleSelectedColor">@color/checkCircleSelected</item>
        <item name="checkCircleCheckColor">@color/checkCircleCheck</item>
        <item name="batchSelectHighlightColor">@color/batchSelectHighlight</item>

        <item name="checkBoxColor">@color/colorAccent</item>
        <item name="checkboxStyle">@style/checkBoxStyle</item>

        <item name="slskAccent">#437eab</item>

        <item name="snackbarButtonStyle">@style/Seeker.Snackbar.Action</item>

        <item name="windowActionModeOverlay">true</item>
        <item name="android:actionModeBackground">?attr/appBarColor</item>
        <item name="actionModeBackground">?attr/appBarColor</item>
        <item name="actionModeTheme">@style/AppTheme.ActionModeOverlay</item>

        <!-- Without this, BottomSheetDialogFragment falls back to Theme.Design.Light.BottomSheetDialog,
             whose colorPrimary is Material's default teal, not the app's purple. That mismatch is
             visible on any MaterialButton/MaterialButtonToggleGroup/MaterialCheckBox inside a sheet. -->
        <item name="bottomSheetDialogTheme">@style/SeekerBottomSheetDialog</item>
    </style>

    <style name="SeekerBottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog" />

    <style name="Seeker.Snackbar.Action" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">?attr/snackbarActionColor</item>
    </style>

    <style name="checkBoxStyle" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="materialThemeOverlay">@style/ThemeOverlay.Seeker.CheckBox</item>
    </style>

    <style name="ThemeOverlay.Seeker.CheckBox" parent="">
        <item name="colorPrimary">?attr/checkBoxColor</item>
    </style>

    <style
        name="CustomSpinnerTheme"
        parent="@android:style/Widget.TextView.SpinnerItem"
    >
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/normalTextColor</item>
    </style>

    <style name="SeekerButtonStyle">
        <item name="android:textColor">#ffffff</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:background">@drawable/rounded_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="BottomNavActiveIndicator" parent="">
        <item name="android:color">?attr/whitePurpleForNavBar</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">
            @style/ShapeAppearance.BottomNavIndicator
        </item>
    </style>

    <style name="ShapeAppearance.BottomNavIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="navTextInactive">
        <item name="android:textColor">#ffffff</item>
    </style>

    <style name="navTextActive">
        <item name="android:textColor">#ffffff</item>
    </style>

    <style
        name="AppTheme.AppBarOverlay"
        parent="ThemeOverlay.Material3.Dark.ActionBar"
    >
        <item name="actionModeStyle">@style/MyActionMode</item>
        <item name="colorControlNormal">?attr/appBarIconColor</item>
    </style>

    <style name="AppTheme.ActionModeOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">?attr/appBarIconColor</item>
    </style>

    <!-- light app bar (Modern light), needs dark title / icons -->
    <style name="AppTheme.AppBarOverlay.Light" parent="ThemeOverlay.Material3.ActionBar">
        <item name="actionModeStyle">@style/MyActionMode</item>
        <item name="colorControlNormal">?attr/appBarIconColor</item>
        <item name="android:textColorPrimary">?attr/appBarTextColor</item>
    </style>

    <style name="AppTheme.ActionModeOverlay.Light" parent="ThemeOverlay.Material3.ActionBar">
        <item name="colorControlNormal">?attr/appBarIconColor</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <!--<style name="Widget.App.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
    <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomNavigationView</item>
  </style>

  <style name="ThemeOverlay.App.BottomNavigationView" parent="">
    <item name="colorPrimary">@android:color/holo_blue_bright</item>
    <item name="colorOnPrimary">@android:color/holo_blue_bright</item>
  </style>-->

    <!-- Settings screen styles -->
    <style name="SettingsSectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="StatCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardBackgroundColor">?attr/user_info_chip_background</item>
    </style>

    <style name="SettingsCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/slightContrastColor</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">6dp</item>
    </style>

    <style name="SettingsCheckBox" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="SettingsSmallButton" parent="SeekerButtonStyle">
        <item name="android:textSize">12sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">16dp</item>
        <item name="android:foreground">@drawable/button</item>
    </style>

    <style name="SettingsHelpIcon">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="srcCompat">@drawable/help_circle_outline</item>
        <item name="android:tint">?attr/mainTextColor</item>
    </style>

    <style name="AppPopupOverlay" parent="ThemeOverlay.Material3.Light">
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
        <item name="android:popupMenuStyle">@style/AppPopupMenu</item>
        <item name="android:textColorPrimary">?attr/cellTextColor</item>
    </style>

    <style name="AppPopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_bg</item>
        <item name="android:popupElevation" tools:targetApi="21">8dp</item>
    </style>

    <!-- SeekerOG shared styles -->
    <style name="SeekerOG.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/glassAccentSecondary</item>
    </style>
    <style name="SeekerOG.GlassCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/glassCardColor</item>
        <item name="strokeColor">?attr/glassStroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="SeekerOG.PlayerButton" parent="">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="tint">?attr/glassTextPrimary</item>
    </style>

    <!-- ===== SeekerOG design system v2 (player + filters redesign) ===== -->
    <style name="SeekerOG.Shape.Chip" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="SeekerOG.Shape.Field" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="SeekerOG.Shape.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="SeekerOG.Shape.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- Selectable chip used by filters, quality presets and library tabs -->
    <style name="SeekerOG.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearance">@style/SeekerOG.Shape.Chip</item>
        <item name="chipBackgroundColor">@color/og_chip_bg</item>
        <item name="chipStrokeColor">@color/og_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">38dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="android:textColor">@color/og_chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="checkedIconTint">?attr/glassAccentSecondary</item>
        <item name="chipIconTint">@color/og_chip_text</item>
        <item name="rippleColor">@color/og_chip_bg</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>
    <!-- Non-checkable action chip (profiles, shortcuts) -->
    <style name="SeekerOG.Chip.Action" parent="Widget.Material3.Chip.Assist">
        <item name="shapeAppearance">@style/SeekerOG.Shape.Chip</item>
        <item name="chipBackgroundColor">?attr/glassFieldColor</item>
        <item name="chipStrokeColor">?attr/glassOutline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">38dp</item>
        <item name="android:textColor">?attr/glassTextPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="chipIconTint">?attr/glassAccentSecondary</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>
    <!-- Small read-only info chip (audio quality) -->
    <style name="SeekerOG.InfoPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/og_info_pill</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/glassTextPrimary</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Rounded outlined text field -->
    <style name="SeekerOG.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="shapeAppearance">@style/SeekerOG.Shape.Field</item>
        <item name="boxBackgroundColor">?attr/glassFieldColor</item>
        <item name="boxStrokeColor">@color/og_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">?attr/glassAccentSecondary</item>
        <item name="android:textColorHint">?attr/glassTextSecondary</item>
        <item name="suffixTextColor">?attr/glassTextSecondary</item>
        <item name="startIconTint">?attr/glassTextSecondary</item>
        <item name="endIconTint">?attr/glassTextSecondary</item>
    </style>

    <!-- Buttons -->
    <style name="SeekerOG.Button.Primary" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/SeekerOG.Shape.Pill</item>
        <item name="backgroundTint">?attr/glassAccent</item>
        <item name="android:textColor">?attr/glassOnAccent</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="SeekerOG.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/SeekerOG.Shape.Pill</item>
        <item name="strokeColor">?attr/glassOutline</item>
        <item name="android:textColor">?attr/glassTextPrimary</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="SeekerOG.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/glassAccentSecondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="SeekerOG.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearance">@style/SeekerOG.Shape.Pill</item>
        <item name="backgroundTint">?attr/glassFieldColor</item>
        <item name="android:textColor">?attr/glassTextPrimary</item>
        <item name="iconTint">?attr/glassAccentSecondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Section title inside filter cards -->
    <style name="SeekerOG.CardTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/glassTextPrimary</item>
    </style>
    <style name="SeekerOG.CardSubtitle" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/glassTextSecondary</item>
    </style>
    <style name="SeekerOG.MiniLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/glassTextSecondary</item>
    </style>

    <!-- Rounded bottom sheet with transparent window so our glass background shows -->
    <style name="SeekerOG.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/SeekerOG.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="SeekerOG.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="SeekerOG.FilterSection" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/og_section_card</item>
    </style>
</resources>
