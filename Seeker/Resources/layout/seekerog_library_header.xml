<?xml version="1.0" encoding="utf-8"?>
<!-- Detail header (album / artist / folder / playlist / favourites / downloads) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/og_section_card"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/og_hdr_art"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/og_art_placeholder"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/SeekerOG.Shape.Field" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/og_hdr_kind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
                android:textColor="?attr/glassAccentSecondary"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/og_hdr_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/glassTextPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/og_hdr_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/glassTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/og_hdr_play"
            style="@style/SeekerOG.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/seekerog_play_all"
            app:icon="@drawable/og_play"
            app:iconGravity="textStart"
            app:iconTint="?attr/glassOnAccent" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/og_hdr_shuffle"
            style="@style/SeekerOG.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/seekerog_player_shuffle"
            app:icon="@drawable/og_shuffle"
            app:iconGravity="textStart"
            app:iconTint="?attr/glassAccentSecondary" />
    </LinearLayout>
</LinearLayout>
