<?xml version="1.0" encoding="utf-8"?>
<!-- Track / artist / folder / playlist row -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/og_row_surface"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginTop="1dp"
    android:layout_marginBottom="1dp"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <FrameLayout
        android:layout_width="50dp"
        android:layout_height="50dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/og_row_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/og_art_placeholder"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/SeekerOG.Shape.Chip" />
        <ImageView
            android:id="@+id/og_row_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            app:tint="#FFFFFFFF" />
        <TextView
            android:id="@+id/og_row_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/og_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/glassTextPrimary"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/og_row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/glassTextSecondary"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">
        <TextView
            android:id="@+id/og_row_badge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:background="@drawable/og_info_pill"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:textColor="?attr/glassTextSecondary"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/og_row_trailing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="?attr/glassTextSecondary"
            android:textSize="12sp" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/og_row_more"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/seekerog_more"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/og_more"
        app:tint="?attr/glassTextSecondary" />
</LinearLayout>
