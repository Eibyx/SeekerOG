<?xml version="1.0" encoding="utf-8"?>
<!--
  SeekerOG advanced filters v2: glass bottom sheet.
  header (title, active count, reset) > saved profiles row > section cards
  (formats > quality > size & duration > availability > text > summary) > sticky action bar.
  It still produces the same text syntax users can type (format:flac bits:24 ...).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/og_sheet_bg"
    android:orientation="vertical">

    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:alpha="0.5"
        android:background="@drawable/og_sheet_handle" />

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/seekerog_filters_title"
                android:textColor="?attr/glassTextPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/og_f_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/glassTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/og_f_help"
            style="@style/SeekerOG.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/seekerog_syntax" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/og_f_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <!-- saved profiles -->
            <HorizontalScrollView
                android:id="@+id/og_f_profiles_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scrollbars="none">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/og_f_profiles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true" />
            </HorizontalScrollView>

            <!-- FORMATS -->
            <LinearLayout style="@style/SeekerOG.FilterSection">
                <include android:id="@+id/og_f_sec_formats" layout="@layout/seekerog_filter_section_header" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/og_format_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/SeekerOG.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/seekerog_f_custom_formats">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/og_custom_formats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- QUALITY -->
            <LinearLayout style="@style/SeekerOG.FilterSection">
                <include android:id="@+id/og_f_sec_quality" layout="@layout/seekerog_filter_section_header" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/og_quality_flags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:chipSpacingHorizontal="8dp">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/og_lossless"
                        style="@style/SeekerOG.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/seekerog_f_lossless"
                        app:chipIcon="@drawable/og_hd"
                        app:chipIconVisible="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/og_hires"
                        style="@style/SeekerOG.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/seekerog_f_hires_short"
                        app:chipIcon="@drawable/og_equalizer"
                        app:chipIconVisible="true" />
                </com.google.android.material.chip.ChipGroup>

                <TextView style="@style/SeekerOG.MiniLabel" android:text="@string/seekerog_f_bitrate" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/og_bitrate_presets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"
                    app:selectionRequired="false"
                    app:singleSelection="true" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SeekerOG.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="@string/seekerog_f_min"
                        app:suffixText="kbps">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/og_min_bitrate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SeekerOG.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="@string/seekerog_f_max"
                        app:suffixText="kbps">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/og_max_bitrate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView style="@style/SeekerOG.MiniLabel" android:text="@string/seekerog_f_samplerate_min" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/og_samplerate_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <TextView style="@style/SeekerOG.MiniLabel" android:text="@string/seekerog_f_bitdepth_min" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/og_bitdepth_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true" />
            </LinearLayout>

            <!-- SIZE & DURATION -->
            <LinearLayout style="@style/SeekerOG.FilterSection">
                <include android:id="@+id/og_f_sec_size" layout="@layout/seekerog_filter_section_header" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SeekerOG.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="@string/seekerog_f_size_min"
                        app:suffixText="MB">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/og_min_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SeekerOG.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="@string/seekerog_f_size_max"
                        app:suffixText="MB">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/og_max_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SeekerOG.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="@string/seekerog_f_dur_min"
                        app:placeholderText="3:30">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/og_min_dur"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SeekerOG.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="@string/seekerog_f_dur_max"
                        app:placeholderText="10:00">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/og_max_dur"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- AVAILABILITY -->
            <LinearLayout style="@style/SeekerOG.FilterSection">
                <include android:id="@+id/og_f_sec_avail" layout="@layout/seekerog_filter_section_header" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/og_free_slot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/seekerog_f_free_slot"
                    android:textColor="?attr/glassTextPrimary"
                    android:textSize="14sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SeekerOG.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="@string/seekerog_f_max_queue_short">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/og_max_queue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/SeekerOG.Field"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="@string/seekerog_f_min_speed_short"
                        app:suffixText="KB/s">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/og_min_speed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- TEXT -->
            <LinearLayout style="@style/SeekerOG.FilterSection">
                <include android:id="@+id/og_f_sec_text" layout="@layout/seekerog_filter_section_header" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/SeekerOG.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/seekerog_f_exclude"
                    app:helperText="@string/seekerog_f_exclude_help"
                    app:startIconDrawable="@drawable/og_close">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/og_exclude"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/SeekerOG.Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/seekerog_f_extra"
                    app:helperText="@string/seekerog_f_extra_help"
                    app:startIconDrawable="@drawable/og_text">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/og_extra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- SUMMARY -->
            <LinearLayout style="@style/SeekerOG.FilterSection">
                <include android:id="@+id/og_f_sec_summary" layout="@layout/seekerog_filter_section_header" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/og_f_summary_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp" />
                <TextView
                    android:id="@+id/og_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/og_info_pill"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:textColor="?attr/glassTextPrimary"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- sticky actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/og_bottom_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/og_f_save"
            style="@style/SeekerOG.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/seekerog_save_profile"
            app:icon="@drawable/og_wishlist"
            app:iconTint="?attr/glassAccentSecondary" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/og_f_clear"
            style="@style/SeekerOG.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/seekerog_clear" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/og_f_apply"
            style="@style/SeekerOG.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:text="@string/seekerog_apply" />
    </LinearLayout>
</LinearLayout>
