<?xml version="1.0" encoding="utf-8" ?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
>
    <LinearLayout
        android:id="@+id/focusableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:focusable="true"
        android:focusableInTouchMode="true"
    />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <include
            android:id="@+id/wishlistBanner"
            layout="@layout/wishlist_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlways" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/linearProgressIndicator"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="gone"
        app:trackCornerRadius="0dp"
        app:trackInnerCornerRadius="2dp"
        app:indicatorColor="?attr/mainPurple"
        android:indeterminateOnly="true" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/searchHeaderBackground"
            app:layout_scrollFlags="scroll|enterAlways" />
		<View
			android:id="@+id/chipsSeparator"
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:visibility="gone"
			app:layout_scrollFlags="scroll|enterAlways"
			android:background="@color/bolderTint" />
        <include
            android:id="@+id/searchResultsHeader"
            layout="@layout/search_results_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlways" />
    </com.google.android.material.appbar.AppBarLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:descendantFocusability="beforeDescendants"
        android:focusableInTouchMode="true"
        tools:context="android.PageFragment"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSearches"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:paddingBottom="80dp"
            android:clipToPadding="false" />

        <ViewFlipper
            android:id="@+id/searchEmptyStateFlipper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:translationY="-48dp"
            android:inAnimation="@null"
            android:outAnimation="@null"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/searchLoadingView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/searchLoadingSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:indicatorSize="120dp"
                    app:trackCornerRadius="5dp"
                    app:trackThickness="6dp"
                    app:indicatorColor="?attr/mainPurple"
                    android:indeterminateOnly="true" />

                <TextView
                    android:id="@+id/searchLoadingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="320dp"
                    android:gravity="center"
                    android:breakStrategy="balanced"
                    android:text="@string/searching_label"
                    android:textSize="18sp"
                    android:textColor="?attr/cellTextColor"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/searchLoadingQueryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="320dp"
                    android:gravity="center"
                    android:breakStrategy="balanced"
                    android:textSize="14sp"
                    android:textColor="?attr/cellTextColorSubdued"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/noResultsView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/search_no_results"
                    android:tint="?attr/cellTextColorSubdued" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="320dp"
                    android:gravity="center"
                    android:breakStrategy="balanced"
                    android:text="@string/no_results_title"
                    android:textSize="18sp"
                    android:textColor="?attr/cellTextColor"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/noResultsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="320dp"
                    android:gravity="center"
                    android:breakStrategy="balanced"
                    android:textSize="14sp"
                    android:textColor="?attr/cellTextColorSubdued"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/allFilteredView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/filter_list_96dp"
                    android:tint="?attr/cellTextColorSubdued" />

                <TextView
                    android:id="@+id/allFilteredTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="320dp"
                    android:gravity="center"
                    android:breakStrategy="balanced"
                    android:textSize="18sp"
                    android:textColor="?attr/cellTextColor"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="320dp"
                    android:gravity="center"
                    android:breakStrategy="balanced"
                    android:text="@string/results_hidden_subtitle"
                    android:textSize="14sp"
                    android:textColor="?attr/cellTextColorSubdued"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/noSearchesView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/search"
                    android:tint="?attr/cellTextColorSubdued" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="320dp"
                    android:gravity="center"
                    android:breakStrategy="balanced"
                    android:text="@string/no_searches"
                    android:textSize="18sp"
                    android:textColor="?attr/cellTextColor"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="320dp"
                    android:gravity="center"
                    android:breakStrategy="balanced"
                    android:text="@string/no_searches_subtitle"
                    android:textSize="14sp"
                    android:textColor="?attr/cellTextColorSubdued"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/searchFailedView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/alert_circle_outline"
                    android:tint="?attr/cellTextColorSubdued" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="320dp"
                    android:gravity="center"
                    android:breakStrategy="balanced"
                    android:text="@string/search_failed_title"
                    android:textSize="18sp"
                    android:textColor="?attr/cellTextColor"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/searchFailedReason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="320dp"
                    android:gravity="center"
                    android:breakStrategy="balanced"
                    android:textSize="14sp"
                    android:textColor="?attr/cellTextColorSubdued"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </ViewFlipper>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="@string/bottom_sheet_behavior"
        android:id="@+id/bottomSheet"
        android:background="@drawable/og_sheet_bg"
    >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
        >
            <View
                android:layout_width="36dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:alpha="0.5"
                android:background="@drawable/og_sheet_handle"
            />
            <!-- SeekerOG: quick filter header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
            >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="@string/seekerog_quick_filter_title"
                    android:textColor="?attr/glassTextPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                />
                <TextView
                    android:id="@+id/og_quick_count"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/og_info_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="?attr/glassTextSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                />
                <!-- room for the floating filter button anchored at the top-right corner -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/SeekerOG.Field"
                android:id="@+id/filterLineOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:hint="@string/filter_search_results_here"
                app:startIconDrawable="@drawable/og_search"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/og_tune"
                app:endIconContentDescription="@string/seekerog_advanced_filters"
            >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/filterText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:focusable="true"
                    android:imeOptions="actionDone"
                />
            </com.google.android.material.textfield.TextInputLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:scrollbars="none"
            >
                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:singleLine="true"
                >
                    <com.google.android.material.chip.Chip
                        android:id="@+id/og_quick_advanced"
                        style="@style/SeekerOG.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/seekerog_quick_advanced"
                        app:chipIcon="@drawable/og_tune"
                        app:chipIconVisible="true"
                    />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/og_quick_profiles"
                        style="@style/SeekerOG.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/seekerog_quick_profiles"
                        app:chipIcon="@drawable/og_wishlist"
                        app:chipIconVisible="true"
                    />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/og_quick_dupes"
                        style="@style/SeekerOG.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/seekerog_quick_dupes"
                    />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/og_quick_help"
                        style="@style/SeekerOG.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/seekerog_syntax"
                        app:chipIcon="@drawable/og_info"
                        app:chipIconVisible="true"
                    />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_format_label"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textColor="?attr/cellTextColorSubdued"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
				android:visibility="gone"
            />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/formatToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="4dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/formatAny"
				android:visibility="gone"
            >
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/formatAny"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_any"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"

                />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/formatLossless"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_format_lossless"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"

                />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/formatLossy"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_format_lossy"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"

                />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_min_bitrate_label"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textColor="?attr/cellTextColorSubdued"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
				android:visibility="gone"
            />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/bitrateToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="4dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/bitrateAny"
				android:visibility="gone"
            >
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bitrateAny"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_any"
                    android:textSize="10sp"
                    android:minWidth="0dp"

                />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bitrate320"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="320"
                    android:textSize="10sp"
                    android:minWidth="0dp"

                />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bitrate256"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="256"
                    android:textSize="10sp"
                    android:minWidth="0dp"

                />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bitrate192"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="192"
                    android:textSize="10sp"
                    android:minWidth="0dp"

                />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bitrate128"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="128"
                    android:textSize="10sp"
                    android:minWidth="0dp"

                />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:layout_height="wrap_content"
            >
                <com.google.android.material.button.MaterialButton
                    style="@style/SeekerOG.Button.Tonal"
                    android:text="Show Smart Filters"
                    android:id="@+id/toggleSmartFilters"
                    android:textSize="13sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/og_summary"
                    app:iconSize="18dp"
                />
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                />
                <!-- Chip extends CheckBox, so existing code keeps working with it -->
                <com.google.android.material.chip.Chip
                    style="@style/SeekerOG.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/stickyFilterCheckbox"
                    android:checkable="true"
                    android:text="@string/persist_it"
                    app:chipIcon="@drawable/og_pin"
                    app:chipIconVisible="true"
                    app:checkedIconVisible="false"
                />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="?attr/glassAccent"
        app:tint="?attr/glassOnAccent"
        app:shapeAppearanceOverlay="@style/SeekerOG.Shape.Fab"
        app:layout_anchor="@id/bottomSheet"
        app:borderWidth="0dp"
        app:fabSize="mini"
        app:layout_anchorGravity="top|right|end"
        android:id="@+id/bsbutton"
        android:layout_margin="16dp"
    />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
