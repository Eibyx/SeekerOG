<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/og_sheet_bg"
    android:orientation="vertical">
    <View
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:alpha="0.5"
        android:background="@drawable/og_sheet_handle" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/seekerog_queue"
                android:textColor="?attr/glassTextPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/og_queue_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/glassTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/og_queue_shuffle"
            style="@style/SeekerOG.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/seekerog_player_shuffle"
            app:icon="@drawable/og_shuffle"
            app:iconSize="18dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="6dp"
        android:text="@string/seekerog_queue_hint"
        android:textColor="?attr/glassTextSecondary"
        android:textSize="12sp" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/og_queue_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />
</LinearLayout>
